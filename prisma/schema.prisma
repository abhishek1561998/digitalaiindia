generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  // "google" | "password" — Learn enrollment/certificates require "google"
  // (verified identity via Google's email_verified check) so a certificate
  // can't be claimed under an arbitrary self-entered name.
  authProvider  String        @default("password")
  plan          Plan          @default(FREE)
  monthlyLimit  Int           @default(1000)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  apiKeys       ApiKey[]
  usageRecords  UsageRecord[]
  voiceIntegrations VoiceIntegration[]
  enrollments   TrackEnrollment[]
  learnProfile  LearnProfile?
  learnActivity LearnActivity[]
  subscription  Subscription?
  leagueEntries LeagueEntry[]
  learnPrefs    LearnPreferences?
  earnedBadges  EarnedBadge[]
}

// One row per (user, track). stageProgress maps stage index -> 0 | 50 | 100
// (50 = content viewed, 100 = quiz passed) so the course UI and the /learn
// hub can both show granular per-topic progress, not just a single percent.
model TrackEnrollment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId       String
  currentStage  Int       @default(0)
  stageProgress Json      @default("{}")
  points        Int       @default(0)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // "unpaid" | "pending" | "paid" — the certificate (not the course itself)
  // is gated on this. "pending" means the learner submitted a UPI
  // transaction ref and it's awaiting manual verification.
  paymentStatus       String    @default("unpaid")
  paymentRef          String?
  paymentSubmittedAt  DateTime?

  @@unique([userId, trackId])
}

// A user's "bring your own key" connection to a TTS provider (Sarvam AI or
// ElevenLabs), configured from the dashboard Voice tab. The provider key is
// AES-GCM encrypted at rest (same secret as ApiKey.encryptedKey). The single
// row with isActive=true decides which provider the user's voice/tts calls
// use — no Vercel env editing required.
model VoiceIntegration {
  id           String   @id @default(cuid())
  provider     String   // "sarvam" | "elevenlabs"
  encryptedKey String
  keyLastFour  String
  isActive     Boolean  @default(false)
  // Optional per-provider defaults, e.g. { speaker, model } (Sarvam) or
  // { voiceId, modelId, stability, similarityBoost } (ElevenLabs).
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, isActive])
}

model ApiKey {
  id            String   @id @default(cuid())
  name          String
  keyPrefix     String
  keyLastFour   String
  keyHash       String   @unique
  encryptedKey  String
  isActive      Boolean  @default(true)
  requests      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastUsedAt    DateTime?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-key preset that the TTS endpoint falls back to when the request
  // body omits these fields. Lets a customer save "use Rachel @ stability
  // 0.6" once and never repeat it in every call.
  // Shape: { voiceId?: string, modelId?: string, stability?: number, similarityBoost?: number }
  settings      Json?

  @@index([userId, isActive])
}

model UsageRecord {
  id        String   @id @default(cuid())
  month     String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

// One row per learner. Everything the Learn app's habit loop reads on every
// page load — XP total, current streak, freezes — lives here so the header
// never has to aggregate across enrollments.
model LearnProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp            Int       @default(0)
  streak        Int       @default(0)
  longestStreak Int       @default(0)
  // UTC midnight of the day the learner last completed a lesson. Compared
  // against today to decide whether the streak continues, freezes, or resets.
  lastActiveOn  DateTime?
  // Spent automatically to cover one missed day before the streak resets.
  freezes       Int       @default(2)
  // The one lesson a free learner claimed today, as "trackId:stage". Free
  // access is a lesson a day, so the claim has to be remembered across a
  // refresh — otherwise reloading the page buys another lesson.
  dailyLessonKey String?
  // UTC midnight of the day dailyLessonKey belongs to.
  dailyLessonOn  DateTime?
  // Streak length the learner is currently aiming for: 7, 14, 21 or 30.
  // Null until they pick one — we don't assume a goal on their behalf.
  goalDays      Int?
  // When the current goal was set, so a goal restarted after a broken streak
  // is measured from the restart rather than from the first time they chose it.
  goalSetAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// One row per (learner, day) with activity. Powers the week strip and the
// activity heatmap on /learn/you without scanning lesson completions.
model LearnActivity {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // UTC midnight of the day.
  day     DateTime
  xp      Int      @default(0)
  lessons Int      @default(0)

  @@unique([userId, day])
  @@index([userId, day])
}

// Premium access. Deliberately provider-agnostic: `provider`/`providerRef`
// hold whatever the payment flow used (manual UPI today, a gateway later),
// and every gate in the app only ever reads `status` and `currentPeriodEnd`.
model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "none" | "trialing" | "active" | "past_due" | "canceled"
  status           String    @default("none")
  // "monthly" | "annual"
  interval         String    @default("annual")
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  provider         String?
  providerRef      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

// A learner's placement in one weekly league cycle.
//
// Leagues are cohorts of ~30 people competing on XP earned that week. There
// is no League table: a cycle is identified by the Monday it starts plus a
// tier, and membership is just the set of entries sharing both. That keeps
// the weekly rollover a single insert per learner instead of a schema dance.
model LeagueEntry {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // UTC midnight of the cycle's Monday.
  weekStart DateTime
  // 0 = Hydrogen, 1 = Carbon, 2 = Silicon, 3 = Titanium, 4 = Diamond.
  tier     Int      @default(0)
  // Which cohort within the tier — cohorts are capped so a league stays small
  // enough that a rank means something.
  cohort   Int      @default(0)
  // XP earned inside this cycle only, kept separate from LearnProfile.xp.
  xp       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart, tier, cohort, xp])
}

// Per-learner settings for the Learn app.
//
// Deliberately explicit columns rather than a JSON blob: the email flags are
// read by send-time queries ("everyone with streakAlerts on whose streak
// expires tonight"), and that has to be a WHERE clause, not a scan.
model LearnPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Appearance ──
  // "auto" | "light" | "dark"
  theme         String @default("auto")
  // "auto" | "on" | "off" — "auto" defers to prefers-reduced-motion.
  reduceMotion  String @default("auto")

  // ── Sound ──
  narrationEnabled Boolean @default(false)
  // "melodic" | "deep"
  narratorVoice    String  @default("melodic")
  soundEffects     Boolean @default(true)

  // ── Email: streaks ──
  emailStreakReminders Boolean @default(true)
  emailStreakAlerts    Boolean @default(true)

  // ── Email: leagues ──
  emailLeagueReminders Boolean @default(true)
  emailLeagueAlerts    Boolean @default(true)

  // ── Email: learning ──
  emailDailyPractice   Boolean @default(true)
  emailRecommendations Boolean @default(true)

  // ── Email: news ──
  emailNewsletter      Boolean @default(true)
  emailContentLaunches Boolean @default(true)
  emailPromotions      Boolean @default(false)

  // Master switch. When true, nothing but vital account mail is sent,
  // whatever the individual flags say.
  emailOptOutAll Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A badge the learner has earned. Definitions live in lib/learn/badges.ts,
// not here: a badge is content, and content in a table means a migration
// every time we want to add one.
model EarnedBadge {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Matches an id in the badge catalogue.
  badgeId String
  earnedAt DateTime @default(now())
  // Value that triggered it (streak length, XP total, course count), kept so
  // the badge can show what it was actually for.
  value   Int?

  @@unique([userId, badgeId])
  @@index([userId, earnedAt])
}
